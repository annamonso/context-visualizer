# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Frontend
frontend/node_modules/
frontend/dist/
src/chronolog_observability/static/workspace/

# Runtime / data
*.log
logs/
*.csv
# ...except thesis figure data: fig-rollup-scaling.tex reads this CSV at
# compile time, so the document does not build without it.
!thesis/figures/*.csv

# Staging area for material ported in from other trees. Never published.
**/_imported/

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# LaTeX build artefacts. main.pdf IS tracked (the built thesis ships with the
# repo); everything else here is regenerated by thesis/build.sh.
thesis/**/*.aux
thesis/**/*.bbl
thesis/**/*.blg
thesis/**/*.fdb_latexmk
thesis/**/*.fls
thesis/**/*.out
thesis/**/*.synctex.gz
thesis/**/*.toc

# Scratch/working material that must never be published: raw screenshots awaiting
# cropping, scratch exports, etc.
**/inbox/

# Editor / OS
.vscode/
.idea/
.DS_Store
